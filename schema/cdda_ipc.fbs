// CDDA Voxel Frontend IPC protocol — Phase 1 (see plan.md §6).
//
// One length-prefixed frame on the wire = one Envelope (u32 LE length prefix
// is added by the framing layer in crates/proto, it is NOT part of this
// schema). All messages travel inside the Envelope union so either side can
// dispatch on a single root type.
//
// Versioning rules live in docs/protocol.md. Short version: PROTOCOL_VERSION
// (in crates/proto and the C++ stub) bumps on any breaking change; additive
// fields / union members are non-breaking and old readers must ignore fields
// they do not know (FlatBuffers does this by construction).

namespace cdda.ipc;

// ---------------------------------------------------------------------------
// Small value types
// ---------------------------------------------------------------------------

struct Vec3i {
  x: int;
  y: int;
  z: int;
}

/// What a TileDef describes (plan §5 Phase 3 TileDefs export).
enum TileKind : ubyte {
  Terrain = 0,
  Furniture = 1,
  Trap = 2,
  Field = 3,
  Monster = 4,
  Item = 5,
  VehiclePart = 6,
}

/// The game's own visibility-cache enum (src/lightmap.h), exported verbatim.
/// It is an enum, NOT a 0-255 light value. Wire size is one byte.
enum LitLevel : ubyte {
  DARK = 0,
  LOW = 1,
  BRIGHT_ONLY = 2,
  LIT = 3,
  BRIGHT = 4,
  MEMORIZED = 5,
  BLANK = 6,
}

/// Creature facing (src/creature.h FacingDirection). Horizontal flip only —
/// there are NO other values and no 8-way creature sprites.
enum Facing : ubyte {
  NONE = 0,
  LEFT = 1,
  RIGHT = 2,
}

// ---------------------------------------------------------------------------
// Handshake
// ---------------------------------------------------------------------------

table Hello {
  protocol_version: uint32;
  game_version: string;
  tileset_id: string;
  /// Base tile pixel size of the tileset (32 for UltiCa).
  tile_pixel_size: uint32;
  z_min: int32;
  z_max: int32;
}

table HelloAck {
  protocol_version: uint32;
  engine_version: string;
  screen_width: uint32;
  screen_height: uint32;
  dpi: float;
  /// Free-form capability tags, e.g. "ui-shm-v1". Unknown tags are ignored.
  capabilities: [string];
}

// ---------------------------------------------------------------------------
// Tile definitions (sent once at connect)
// ---------------------------------------------------------------------------

table TileDef {
  id: uint32;
  string_id: string;
  name: string;
  kind: TileKind;
  /// String flags exactly as authored in the game data.
  flags: [string];
  /// Resolved ter_furn_flag bitset for engine-fast checks (the engine never
  /// parses JSON flag strings itself).
  hot_flags: uint64;
  /// Indices into TileDefs.connect_groups (the connect_group registry table,
  /// exported once — per-def data is indices, never group name strings).
  connect_groups: [uint16];
  connects_to_groups: [uint16];
  rotate_to_groups: [uint16];
  /// String ids after the game's own transforms; absent/empty = none.
  /// (Senders use absent: the C++ object API packs "" as absent anyway.)
  open_result: string;
  close_result: string;
  bash_result: string;
  looks_like: string;
  /// Indices into the composed tile_config.json tile entries; -1 = none.
  fg_ref: int32 = -1;
  bg_ref: int32 = -1;
  /// String id of the terrain that is the floor above this terrain
  /// (ter_t::roof — "what will be the floor above this terrain").
  /// Absent/empty = this terrain roofs nothing. Added 2026-11-15
  /// (Phase 8): without it the engine cannot resolve what floor an
  /// open-air tile shows (gate 8.4b) and would have to guess.
  /// Appended last: additive/non-breaking, old readers ignore it.
  roof_result: string;
  /// The def's own CDDA colour NAME (the string the game's
  /// `color_from_string` resolves, e.g. "green", "light_gray",
  /// "brown_green"), exactly as authored/inherited in the game
  /// data. Absent = the def carries no colour. Added 2026-11-24
  /// (Phase 11 follow-up Lane J): the name — not an RGB — crosses
  /// the wire; the engine maps names to RGB through the game's
  /// own colour table so both sides agree on what "green" means.
  /// Appended last: additive/non-breaking, old readers ignore it.
  color: string;
}

table TileDefs {
  defs: [TileDef];
  connect_groups: [string];
  protocol_version: uint32;
}

// ---------------------------------------------------------------------------
// World state
// ---------------------------------------------------------------------------

/// One field on one tile. A tile holds SEVERAL fields at once (smoke + fire
/// + ...), each with its own intensity — this is a sparse list, never a
/// single field id per tile.
table FieldOnTile {
  /// Index into the owning SubmapBlock's 12x12 tile arrays (row-major).
  tile_index: uint16;
  /// Field type def id (a TileDef of kind Field).
  type: uint32;
  intensity: ubyte;
}

/// The field the game itself would draw for a tile (cheap path), with its
/// intensity. field_type = 0 means "no displayed field".
struct DisplayedField {
  field_type: uint32;
  intensity: ubyte;
}

/// One 12x12 submap column slice (one z-level). Per-tile arrays are 144
/// entries, row-major (index = y * 12 + x), unless documented otherwise.
table SubmapBlock {
  /// Absolute tile coordinates of the block's corner (x, y) and its z-level.
  origin: Vec3i;
  terrain: [uint32];
  furniture: [uint32];
  trap: [uint32];
  /// Sparse: only tiles that have fields. Several entries may share a
  /// tile_index.
  fields: [FieldOnTile];
  /// Per tile: index of this tile's first entry in `fields`, or -1 = none.
  /// Entries for a tile are contiguous in `fields`.
  field_index: [int32];
  /// Per tile: the field type the game itself would display.
  displayed_field: [DisplayedField];
  /// Per tile: def id of the uppermost item (get_uppermost_item), 0 = none.
  top_item: [uint32];
  /// Per tile: item stack size; >1 means a pile.
  item_count: [uint16];
  /// Per tile: lit_level enum (DARK..BLANK), one byte each.
  lit: [LitLevel];
  /// Per tile: quantized seen/visibility value, 0 = never seen, 255 = full.
  seen: [ubyte];
  /// Per tile: graffiti present.
  has_graffiti: [bool];
  /// Per tile: sky-exposed (Phase 10, decision 4A) — the game's own
  /// test, map::is_outside(p) && !map::is_roofed(p), resolved
  /// game-side. Drives the per-tile sky factor for sky GI.
  /// Appended last: additive/non-breaking, old readers ignore it,
  /// old data reads as absent (= not exposed).
  outside: [bool];
  /// Per tile: smooth-lighting fraction (Phase 11 S3, Addendum 11):
  /// light_above_threshold(apparent_light, vision_threshold) scaled
  /// to 0..255 — 255 for BRIGHT, the threshold fraction for LOW/LIT,
  /// 0 otherwise. The game's visibility/ceiling verdict for the
  /// tile; renderer-transported light stays capped by it (option A).
  /// Appended last: additive/non-breaking, old readers ignore it,
  /// old data reads as absent (= derive from lit/seen as before).
  light_frac: [ubyte];
  /// Per tile: normalised light colour (Phase 11 S3, Addendum 11):
  /// illumination_hue of the tile's accumulated light colour —
  /// 3 ubytes per tile (R, G, B interleaved, same tile order as
  /// `lit`), brightest channel 255 when coloured, 255/255/255 =
  /// uncoloured. Appended last: additive/non-breaking, old data
  /// reads as absent (= white).
  light_tint: [ubyte];
}

table Entity {
  id: uint64;
  /// Monster/character type def id (TileDef kind Monster) where applicable.
  type_def: uint32;
  sprite_id: string;
  pos: Vec3i;
  facing: Facing;
  /// Overlay ids in the game's own order (get_overlay_ids). Do NOT re-sort.
  overlays: [string];
  /// Hit points as 0-255 fraction of max.
  hp_frac: ubyte;
  /// Bit flags: friendly, hostile, sleeping, ... (bits assigned by the fork).
  flags: uint32;
}

table VehiclePartState {
  vpart: uint32;
  /// Absolute tile position, computed game-side from pre-rotated mounts.
  abs_pos: Vec3i;
  mount: Vec3i;
  hp_frac: ubyte;
  /// Bit flags: open, broken, roof, ...
  flags: uint32;
}

table Vehicle {
  id: uint64;
  name: string;
  /// Continuous facing in degrees (vehicle::face.dir()). Never quantized.
  face_deg: float;
  parts: [VehiclePartState];
}

/// Game time + weather at the player (Phase 10, docs/phase10-sky-gi.md
/// §2.2). Weather crosses the wire as string id + resolved numeric
/// fields, never as a closed enum alone: weather types are JSON-defined
/// and mod-extensible, and a modded type the engine has never heard of
/// must still light correctly from the numerics.
table EnvironmentUpdate {
  seq: uint64;
  epoch: uint64;
  /// Game time: total turns since calendar::turn_zero, plus the
  /// derived values the engine should not have to re-derive.
  turn: int64;
  time_of_day_sec: float;      // 0..86400, fractional
  sunrise_sec: float;          // today, game-local
  sunset_sec: float;
  season: ubyte;               // season_type: 0 spring .. 3 winter
  sun_light: float;            // incident_sunlight(wtype, turn)
  moon_light: float;           // incident_moonlight(wtype, turn)
  sun_azimuth_deg: float;      // sun_azimuth_altitude(turn).first — from South, west-positive
  sun_altitude_deg: float;     // sun_azimuth_altitude(turn).second — negative below horizon
  moon_phase: ubyte;           // get_moon_phase(turn), 0..MOON_PHASE_MAX
  /// Weather at the player (weather_manager state).
  weather_id: string;          // e.g. "weather_rain"
  light_multiplier: float;     // weather_type fields, resolved game-side
  light_modifier: float;
  sun_multiplier: float;
  precip_class: ubyte;         // 0 none, 1 very_light, 2 light, 3 heavy
  rains: bool;
  sight_penalty: float;        // -> fog density input
  tint_rgb: [float];           // weather_type tint_color, 3 entries or absent
  tint_strength: float;
  temperature_c: float;
  windspeed_mph: float;
  wind_dir_deg: float;
  lightning_active: bool;
}

table Snapshot {
  view_origin: Vec3i;
  view_radius: uint32;
  blocks: [SubmapBlock];
  /// Remembered-but-not-visible tiles: terrain/furniture only, lit =
  /// MEMORIZED, never live entities/items/fields.
  memory_blocks: [SubmapBlock];
  entities: [Entity];
  vehicles: [Vehicle];
  seq: uint64;
  epoch: uint64;
  /// Current environment, piggybacked so a fresh client is never
  /// environment-blind before the first EnvironmentUpdate (Phase 10
  /// §2.2). Appended last: additive/non-breaking.
  environment: EnvironmentUpdate;
}

/// A single tile's new state inside a Delta (absolute position).
table TileChange {
  pos: Vec3i;
  terrain: uint32;
  furniture: uint32;
  trap: uint32;
  /// All fields now on this tile (replaces the tile's previous field list).
  fields: [FieldOnTile];
  top_item: uint32;
  item_count: uint16;
  lit: LitLevel;
  seen: ubyte;
  has_graffiti: bool;
  /// The field the game itself would display after this change
  /// (field::displayed_field_type + its intensity). Added 2026-11-15:
  /// without it the engine cannot update the displayed field from a
  /// Delta alone and would have to re-derive the game's rule.
  /// field_type = 0 means "no displayed field". Additive/non-breaking:
  /// old readers ignore it, old data reads as 0/0.
  displayed_field: DisplayedField;
  /// Sky-exposed after this change (Phase 10; same game-side test as
  /// SubmapBlock.outside). Appended last: additive/non-breaking, old
  /// data reads as false.
  outside: bool;
  /// Smooth-lighting fraction after this change (Phase 11 S3;
  /// same definition as SubmapBlock.light_frac). Appended last:
  /// additive/non-breaking, old data reads as 0.
  light_frac: ubyte;
  /// Normalised light colour after this change (Phase 11 S3;
  /// same definition as SubmapBlock.light_tint, one tile's RGB).
  /// Appended last: additive/non-breaking, old data reads as 0
  /// (= white by the absent-field convention).
  light_tint_r: ubyte;
  light_tint_g: ubyte;
  light_tint_b: ubyte;
}

table Delta {
  seq: uint64;
  epoch: uint64;
  tile_changes: [TileChange];
  entity_updates: [Entity];
  entity_removed: [uint64];
  vehicle_updates: [Vehicle];
  vehicle_removed: [uint64];
  /// Environment when it changed at this send boundary (Phase 10
  /// §2.3); usually absent. Appended last: additive/non-breaking.
  environment: EnvironmentUpdate;
}

/// Standalone light/visibility refresh (folded into Delta when small).
table LightUpdate {
  seq: uint64;
  epoch: uint64;
  origin: Vec3i;
  lit: [LitLevel];
  seen: [ubyte];
  /// Smooth-lighting fraction per tile (Phase 11 S3; same
  /// definition and shape as SubmapBlock.light_frac).
  /// Appended last: additive/non-breaking, old data reads as
  /// absent (= derive from lit/seen as before).
  light_frac: [ubyte];
  /// Normalised light colour per tile (Phase 11 S3; same
  /// definition and interleaved-RGB shape as
  /// SubmapBlock.light_tint). Appended last: additive/non-breaking,
  /// old data reads as absent (= white).
  light_tint: [ubyte];
}

// ---------------------------------------------------------------------------
// Effects
// ---------------------------------------------------------------------------

enum EffectKind : ubyte {
  Animation = 0,
  Projectile = 1,
  Sound = 2,
  HitFlash = 3,
  Explosion = 4,
  Other = 5,
}

table EffectEvent {
  kind: EffectKind;
  /// Tileset/animation id or sound id, depending on kind.
  effect_id: string;
  from_pos: Vec3i;
  to_pos: Vec3i;
  duration_ms: uint32;
}

table Effects {
  seq: uint64;
  events: [EffectEvent];
}

// ---------------------------------------------------------------------------
// UI compositing
// ---------------------------------------------------------------------------

enum UiMode : ubyte {
  /// Game expects map/world input; engine camera controls are active.
  MapInput = 0,
  /// A menu/UI has focus; clicks stay in UI space, camera drags are ignored.
  UiInput = 1,
}

/// Notification that a new UI frame is ready in shared memory.
table UiFrame {
  /// Which of the two shared-memory buffers holds this frame.
  buffer_index: ubyte;
  width: uint32;
  height: uint32;
  stride: uint32;
  seq: uint64;
  dirty_x: int32;
  dirty_y: int32;
  dirty_w: int32;
  dirty_h: int32;
  mode: UiMode;
  /// The terrain window's rect in UI pixels (reported by the game, never
  /// assumed — it depends on terminal size and panel layout). -1 = unknown.
  terrain_rect_x: int32 = -1;
  terrain_rect_y: int32 = -1;
  terrain_rect_w: int32 = -1;
  terrain_rect_h: int32 = -1;
}

// ---------------------------------------------------------------------------
// Engine -> game
// ---------------------------------------------------------------------------

enum InputKind : ubyte {
  Key = 0,
  Text = 1,
  MouseButton = 2,
  MouseMove = 3,
  Wheel = 4,
  Focus = 5,
}

table Input {
  kind: InputKind;
  /// Platform-independent key code for Key events (fork injector maps it
  /// into the game's input path).
  key_code: int32;
  /// Text payload for Text events.
  text: string;
  /// Mouse position in UI/display-buffer pixel space.
  mouse_x: int32;
  mouse_y: int32;
  /// Mouse button index for MouseButton events (-1 = none).
  button: int32 = -1;
  pressed: bool;
  /// Wheel delta (lines, signed) for Wheel events.
  wheel_delta: int32;
  /// Modifier bitmask: 1=shift, 2=ctrl, 4=alt, 8=meta.
  modifiers: uint32;
  /// Focus state for Focus events.
  focused: bool;
}

table Resize {
  width: uint32;
  height: uint32;
  dpi: float;
}

table PickResult {
  request_id: uint64;
  hit: bool;
  pos: Vec3i;
}

// ---------------------------------------------------------------------------
// Liveness / lifecycle
// ---------------------------------------------------------------------------

table Ping {
  nonce: uint64;
  sent_ms: uint64;
}

table Pong {
  nonce: uint64;
  sent_ms: uint64;
}

table Shutdown {
  reason: string;
}

// ---------------------------------------------------------------------------
// Envelope: one frame = one of these
// ---------------------------------------------------------------------------

union Message {
  Hello,
  HelloAck,
  TileDefs,
  Snapshot,
  Delta,
  LightUpdate,
  Effects,
  UiFrame,
  Input,
  Resize,
  PickResult,
  Ping,
  Pong,
  Shutdown,
  // Phase 10: appended LAST on purpose — union member ids are
  // positional, so appending is the only non-breaking placement.
  // Old readers see an unknown member and ignore the message.
  EnvironmentUpdate,
}

table Envelope {
  message: Message;
}

root_type Envelope;
file_identifier "CDDA";
file_extension "cdda";
